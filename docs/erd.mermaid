erDiagram
    countries ||--o{ education_systems : has
    education_systems ||--o{ levels : has
    education_systems ||--o{ tracks : has
    education_systems ||--o{ subjects : has
    countries ||--o{ regions : has

    levels ||--o{ track_subjects : "at level"
    tracks ||--o{ track_subjects : "for track"
    subjects ||--o{ track_subjects : "of subject"

    subjects ||--o{ chapters : contains
    levels ||--o{ chapters : "at level"
    chapters ||--o{ lessons : contains

    education_systems ||--o{ exams : has
    levels ||--o{ exams : "at level"
    tracks ||--o{ exams : "for track"
    subjects ||--o{ exams : "of subject"
    regions ||--o{ exams : "regional only"

    subjects ||--o{ exercises : "of subject"
    chapters ||--o{ exercises : from
    exams ||--o{ exercises : "sourced from"
    exercises ||--o{ questions : has
    questions ||--o{ answer_options : "mcq"
    questions ||--o{ solutions : "HSGenius correction"

    auth_users ||--|| profiles : extends
    profiles ||--|| student_profiles : is
    profiles ||--o{ guardianships : guardian
    profiles ||--o{ consents : gives
    levels ||--o{ student_profiles : enrolled
    tracks ||--o{ student_profiles : filiere

    student_profiles ||--o{ attempts : makes
    questions ||--o{ attempts : on
    student_profiles ||--o{ chapter_mastery : tracks
    chapters ||--o{ chapter_mastery : per
    student_profiles ||--o{ mistakes : logs
    student_profiles ||--o{ recommendations : receives

    student_profiles ||--o{ conversations : starts
    conversations ||--o{ messages : contains

    student_profiles ||--o{ xp_events : earns
