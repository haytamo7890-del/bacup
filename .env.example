# ---- HSGenius environment variables ----
# Copy this file to ".env.local" and fill in real values.
# NEVER commit ".env.local". Only NEXT_PUBLIC_* values reach the browser.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (console.anthropic.com -> API Keys). Server-only.
ANTHROPIC_API_KEY=
